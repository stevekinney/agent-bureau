{
  "name": "agent-bureau",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-changesets": "bun run scripts/check-changesets.ts",
    "check-determinism": "bun run scripts/check-determinism.ts",
    "check-mutation": "bun run scripts/check-mutation.ts",
    "check-runtime-matrix": "bun run scripts/check-runtime-matrix.ts",
    "check-skip-manifest": "bun run scripts/check-skip-manifest.ts",
    "check-types": "turbo run check-types",
    "check:stale-dist": "bun run scripts/check-stale-workspace-dist.ts",
    "coverage:check": "turbo run coverage:check --concurrency=1 --filter=armorer --filter=conversationalist --filter=evaluation --filter=interoperability --filter=lifecycle --filter=memory --filter=@lostgradient/operative --filter=skills --filter=bureau --filter=cloudflare",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "turbo run format:check && prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "integration": "turbo run integration --filter=integration",
    "lint": "turbo run lint",
    "test": "bun run check-changesets && turbo run test && bun run test:scripts",
    "test:cloudflare-conformance": "turbo run test --filter=cloudflare",
    "test:crash-conformance": "bun test packages/integration/test/crash",
    "test:gateway-conformance": "bun test packages/gateway/src/conformance",
    "test:replay-artifact": "bun run scripts/replay-reproduction-artifact.ts",
    "test:scripts": "bun test scripts",
    "verify:armorer:consumer": "bun run scripts/verify-armorer-consumer.ts --mode local",
    "test:consumer:operative": "bun run scripts/verify-operative-consumer.ts --mode local",
    "verify:bureau:tarball-boundary": "bun run scripts/verify-bureau-tarball-boundary.ts",
    "prepare": "lefthook install",
    "validate": "bun run check-changesets && bun run check-determinism && bun run check-runtime-matrix && bun run check-skip-manifest && turbo run format:check lint check-types test --concurrency=2 && prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\" && bun run test:scripts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run scripts/release.ts",
    "check-package-shape": "bun run scripts/check-package-shape.ts armorer conversationalist operative",
    "mutation:baseline": "bun run scripts/check-mutation.ts --write-baseline"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@changesets/parse": "1.0.0",
    "@lostgradient/operative": "workspace:*",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ]
}
