{
  "name": "@lostgradient/bureau",
  "version": "0.0.8",
  "private": true,
  "description": "The agent fleet brain: createBureau, runtime composition, durability, recovery, and agent assembly",
  "keywords": [
    "ai",
    "llm",
    "agent",
    "bureau",
    "fleet",
    "orchestration",
    "typescript"
  ],
  "homepage": "https://github.com/stevekinney/agent-bureau#readme",
  "bugs": {
    "url": "https://github.com/stevekinney/agent-bureau/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevekinney/agent-bureau.git"
  },
  "license": "MIT",
  "author": "Steve Kinney <hello@stevekinney.net>",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage tsconfig.tsbuildinfo",
    "ci": "bun run validate && bun run build",
    "coverage:check": "bun run ../../scripts/check-coverage.ts",
    "dev": "bun --watch run src/index.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "validate": "bun run format:check && bun run lint && bun run check-types && bun run test"
  },
  "dependencies": {
    "@lostgradient/lifecycle": "workspace:*",
    "@lostgradient/memory": "workspace:*",
    "@lostgradient/operative": "workspace:*",
    "@lostgradient/skills": "workspace:*",
    "@lostgradient/tool-protocol": "workspace:*",
    "@lostgradient/weft": "^0.26.0",
    "armorer": "workspace:*",
    "conversationalist": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@eslint/js": "^10.0.1",
    "@google/genai": "^2.19.0",
    "@opentelemetry/api": "^1.9.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.8.1",
    "lmdb": "^3.5.2",
    "oxlint": "^1.83.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.50.0",
    "@google/genai": ">=2.19.0",
    "@opentelemetry/api": "^1.9.1",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
